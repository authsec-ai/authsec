# Copy to config.env and fill in. config.env is git-ignored.

# Organization ID:  gcloud organizations list
# Leave EMPTY for a personal account with no organization (org-only scenarios are skipped)
ORG_ID=""
# Domain verified in Cloud Identity (the test domain, not the company domain)
DOMAIN=""
# Billing account ID (the one Proj1 uses):  gcloud billing projects describe <proj1-id>
BILLING_ACCOUNT=""
# ...or leave BILLING_ACCOUNT empty and reuse a project's billing account:
BILLING_FROM_PROJECT=""     # e.g. gen-lang-client-0261666311 (Proj1)
# You, the org admin running this script
ADMIN_EMAIL=""

# Test users created in admin.google.com (see README step 3). Optional but needed
# for scenarios 10, 12 and 22.
TEST_USER_EMAIL=""          # active user in DOMAIN
SUSPENDED_USER_EMAIL=""     # user in DOMAIN that you suspend after the run
EXTERNAL_USER_EMAIL=""      # any account outside DOMAIN, e.g. a personal Gmail

# GitHub repo allowed through Workload Identity Federation, as owner/repo
GITHUB_REPO=""

REGION="us-central1"        # free-tier e2-micro regions: us-central1, us-east1, us-west1
ZONE="us-central1-a"
PREFIX="iga"
BUDGET_AMOUNT="10"          # USD, alerts at 50 / 90 / 100 %

ENABLE_GKE="no"             # yes = create Autopilot cluster (costs while it runs)
ENABLE_DLP="no"             # DLP discovery is enabled by hand in the console
ENABLE_DATA_ACCESS_LOGS="yes"
