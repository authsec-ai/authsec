# ─────────────────────────────────────────────────────────────────────────────
# AuthSec – merged monolith environment configuration
#
# Combines variables from the former user-flow (port 7468) and
# webauthn-service (port 8080) microservices.
#
# Copy this file to .env and fill in values before running the service.
# ─────────────────────────────────────────────────────────────────────────────


# ─── Server ──────────────────────────────────────────────────────────────────

# TCP port the monolith listens on (was 7468 in user-flow, 8080 in webauthn-service)
PORT=7468

# Gin run mode: debug | release | test
GIN_MODE=debug

# Log level: trace | debug | info | warn | error | fatal | panic
LOG_LEVEL=info

# Runtime environment label used by some handlers (e.g. "development" | "production")
ENVIRONMENT=development


# ─── Primary PostgreSQL database ─────────────────────────────────────────────

DB_HOST=localhost
DB_PORT=5432
DB_NAME=authsec
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public

# SSL mode for PostgreSQL connections: disable | require | verify-ca | verify-full
DB_SSL_MODE=disable


# ─── JWT / Token secrets ─────────────────────────────────────────────────────

# Primary JWT signing secret — used by auth-manager middleware, extsvc controller,
# SPIFFE delegate controller, and the JWT debug middleware. REQUIRED.
JWT_SECRET=change-me-jwt-secret

# Default JWT signing secret (used for admin / platform-level tokens)
JWT_DEF_SECRET=change-me-jwt-def-secret

# SDK JWT signing secret (used for SDK-issued tokens)
JWT_SDK_SECRET=change-me-jwt-sdk-secret


# ─── WebAuthn (FIDO2 Passkeys) ────────────────────────────────────────────────
# These were previously configured only in webauthn-service; now required here.

# Human-readable name displayed to the user during registration
WEBAUTHN_RP_NAME=AuthSec

# Relying Party ID – must match the effective domain of your frontend
# (e.g. "localhost" for local dev, "app.authsec.dev" for production)
WEBAUTHN_RP_ID=localhost

# Origin URL of the frontend that initiates WebAuthn ceremonies
WEBAUTHN_ORIGIN=http://localhost:3000

# Timeout for WebAuthn ceremonies in milliseconds (default: 60000 = 60 s)
WEBAUTHN_TIMEOUT=60000

# Enable verbose WebAuthn debug logging (true | false)
WEBAUTHN_DEBUG=false


# ─── TOTP ────────────────────────────────────────────────────────────────────

# 64-character hex key used to encrypt TOTP secrets at rest
TOTP_ENCRYPTION_KEY=change-me-64-hex-chars-totp-key-here-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AES-256 key for encrypting AD/Entra sync configurations at rest (32 bytes, hex-encoded).
# Without this, encryption falls back to an insecure hardcoded default. REQUIRED in production.
SYNC_CONFIG_ENCRYPTION_KEY=change-me-32-byte-hex-key-for-sync-config-encryption-xxxxxxxx


# ─── Twilio (SMS MFA / voice) ────────────────────────────────────────────────

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sender phone number for SMS OTP codes (read as TWILIO_FROM_NUMBER by the code)
TWILIO_FROM_NUMBER=+10000000000


# ─── SMTP (e-mail delivery) ──────────────────────────────────────────────────

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=change-me-smtp-password


# ─── CORS ────────────────────────────────────────────────────────────────────
#
# CORS_ALLOWED_ORIGINS – comma-separated list of allowed origins for the main
# Gin CORS middleware (covers all routes, both former services).
# Supports wildcard patterns, e.g. "https://*.app.authsec.dev".
# When unset, the origin is derived automatically from WEBAUTHN_ORIGIN.
#
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5501,http://127.0.0.1:3000

# HTTP methods permitted in CORS requests (comma-separated; optional)
# CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# HTTP headers permitted in CORS requests (comma-separated; optional)
# CORS_ALLOWED_HEADERS=Origin,Content-Type,Authorization,X-Requested-With,Accept

# CORS_ALLOW_ORIGIN – legacy variable read by certain user-flow controllers
# (keep in sync with CORS_ALLOWED_ORIGINS or leave empty to inherit)
CORS_ALLOW_ORIGIN=https://*.app.authsec.dev,https://app.authsec.dev,https://*.authsec.dev,https://authsec.dev


# ─── External service URLs ───────────────────────────────────────────────────

# OOC (out-of-channel) manager service URL
OOC_MANAGER_URL=http://localhost:7467

# Hydra OAuth2 / OIDC admin endpoint
HYDRA_ADMIN_URL=http://localhost:4445

# ICP provisioning service (PKI)
ICP_SERVICE_URL=http://localhost:7001

# Base URL for OIDC callbacks and e-mail links (no trailing slash)
BASE_URL=https://app.authsec.dev
OAUTH_ISSUER_URL=https://api.authsec.dev

# AUTH_MANAGER_URL is kept for any auth-manager library calls that need it.
# NOTE: The former inter-service HTTP call from webauthn-service to
#       user-flow's /uflow/webauthn/register is now an in-process bridge call
#       and no longer requires this variable at runtime.
AUTH_MANAGER_URL=https://api.authsec.dev


# ─── Tenant routing ──────────────────────────────────────────────────────────

# Suffix appended to new tenant sub-domains (e.g. "<slug>.app.authsec.dev")
TENANT_DOMAIN_SUFFIX=app.authsec.dev


# ─── Redis (optional caching / token revocation) ─────────────────────────────

# Leave empty to run without Redis (token revocation / refresh will be disabled)
REDIS_URL=redis://localhost:6379


# ─── HashiCorp Vault (optional secret management) ────────────────────────────

VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=


# ─── OIDC provider credentials (fallback when Vault is not available) ─────────

GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_SECRET=


# ─── HubSpot integration (optional) ─────────────────────────────────────────

HUBSPOT_ACCESS_TOKEN=


# ─── OIDC token validation (optional) ───────────────────────────────────────
# Expected issuer and audience claims when validating incoming OIDC tokens.
# Leave empty to skip strict validation.

AUTH_EXPECT_ISS=
AUTH_EXPECT_AUD=


# ─── Server authentication gate ──────────────────────────────────────────────
# Set to "false" in development to bypass the inter-service auth check.

REQUIRE_SERVER_AUTH=true


# ─── SPIFFE / SVID OIDC (optional) ──────────────────────────────────────────
# Required only when SPIFFE workload identity / delegate endpoints are used.

SPIFFE_OIDC_ISSUER=
SPIFFE_JWKS_KEY_ID=
# Base64-encoded PEM RSA private key used to sign SPIFFE JWTs
SPIFFE_RSA_PRIVATE_KEY_B64=
SPIFFE_TRUST_DOMAIN=


# ─── Okta CIBA integration (optional) ────────────────────────────────────────
# Required only when Okta is used as a CIBA (Client-Initiated Backchannel Auth) provider.

OKTA_DOMAIN=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_ISSUER=
OKTA_API_TOKEN=


# ─── Security flags ────────────────────────────────────────────────────────
# These default to the most secure setting; override only if you understand the trade-offs.

# When true, Redis errors during token blacklist checks allow requests through
# instead of returning 503. Default: false (fail-closed).
TOKEN_BLACKLIST_FAIL_OPEN=false

# When true, admin users can access resources belonging to other tenants.
# Default: false (admins are scoped to their own tenant).
ADMIN_CROSS_TENANT_ACCESS=false

# When true, HSTS headers are sent even without TLS termination detected.
# Useful behind a load balancer that strips X-Forwarded-Proto. Default: false.
FORCE_HSTS=false

# ─── AWS cloud discovery ──────────────────────────────────────────────────────
# Onboarding a customer AWS account read-only. See
# docs/cloud-discovery/aws-onboarding.md.

# The AuthSec IAM principal that customers' cross-account discovery roles must
# trust. One identity for every customer; the per-connection ExternalId is what
# keeps them apart. Unset means AWS onboarding reports itself not configured.
#
# In production this is the principal the backend actually runs as: the IRSA
# role, the node role, or the IAM user behind the ambient credentials. If it
# does not match, every customer stack will be created trusting something that
# cannot assume it.
AUTHSEC_AWS_DISCOVERY_PRINCIPAL_ARN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Key used to bind an issued ExternalId to the workspace it was issued to, so an
# ExternalId leaked from one tenant cannot be used to onboard an AWS account
# into another. Falls back to JWT_SECRET when unset.
#
# Rotating it invalidates ExternalIds that have been issued but not yet used. It
# does NOT affect accounts already connected.
AUTHSEC_CLOUD_DISCOVERY_HMAC_KEY=

# AuthSec's OWN AWS credentials are read from the ambient environment by the AWS
# SDK's default chain — an instance role, IRSA, or AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY in development. No customer key is ever stored, and
# there is no per-workspace AWS credential to configure here.

# ─── GCP cloud discovery ──────────────────────────────────────────────────────
# Onboarding a customer GCP org/folder/project read-only, via Workload
# Identity Federation (WIF). JSON-key authentication is not offered as a new
# console onboarding option; the backend retains it only so that existing
# JSON-key connectors keep working.
#
# AUTHSEC_CLOUD_DISCOVERY_HMAC_KEY above is shared with GCP: it also binds the
# derived WIF pool/provider/subject to the (workspace, scope) pair that
# requested them.

# The OIDC issuer AuthSec presents to Google Cloud when a customer's WIF
# provider exchanges a token. Google Cloud unconditionally rejects a
# non-HTTPS issuer when a Workload Identity Pool provider is created, so WIF
# cannot succeed while this resolves to an http:// URL (e.g. plain
# localhost in local dev).
#
# Unset falls back to BASE_URL / OAUTH_ISSUER_URL — fine in any deployment
# that already terminates HTTPS there. Set this separately when that is not
# true locally: point it at a public HTTPS tunnel (e.g. a Cloudflare quick
# tunnel or ngrok) forwarding to this backend, while BASE_URL/OAUTH_ISSUER_URL
# stay on localhost for everything else. Until it resolves to https://, the
# onboarding UI disables WIF — set it (or deploy behind real HTTPS) to
# unlock WIF.
GCP_WIF_ISSUER_URL=


# GCP Google OAuth
GCP_OAUTH_CLIENT_ID=
GCP_OAUTH_CLIENT_SECRET=
GCP_OAUTH_REDIRECT_URI=http://localhost:7001/discovery/gcp/google-oauth/callback

# Enables serving the native-signer's public key from /oauth/jwks (in
# addition to Hydra's), and accepting natively-signed tokens at a few other
# introspection points. Required for GCP WIF: the token AuthSec presents to
# Google's STS is signed by this native signer (internal/tokens/issuer.go),
# so Google can only verify it if this key is actually published.
XAA_NATIVE_SEALER=true

# ─── Azure onboarding ─────────────────────────────────────────────────────────
# Consent an Entra application into a customer's tenants and check whether that
# consent bought ARM Reader. See docs/flows/azure-onboarding.md.
#
# THE APPLICATION DOES NOT LIVE HERE. It is submitted through the API:
#
#     POST /api/azure/config   {clientId, homeTenant, redirectUri,
#                               generateCertificate: true}
#
# and stored per workspace -- the public fields in the azure_app_config table,
# the credential in Vault. AuthSec is self-hosted, so the customer creates the
# registration in their OWN tenant; one baked-in application would mean every
# customer trusting a registration they do not control. Nothing below is needed
# to onboard a tenant, and a deployment that sets none of it works normally.
#
# Nothing in this whole block is required.

# Optional. Signs the browser cookie that addresses an operator's stored Azure
# sign-in. Left unset -- the normal case -- the key is derived from JWT_SECRET
# with HMAC and a purpose label, so it is independent of the JWT signing key
# rather than the same bytes used twice.
#
# Set it only to keep the two blast radii separate: with it, a leaked Azure
# cookie key says nothing about the JWT key. Must be 32+ characters; anything
# shorter is ignored in favour of the derivation rather than used.
# Generate with: openssl rand -base64 48
#
# This is the one Azure secret that cannot live in the database: it is the key
# that protects the session, so storing it in the store it protects is circular.
# SESSION_SECRET=

# ── Optional: a deployment-wide application ───────────────────────────────────
# A fallback for a SINGLE-TENANT deployment that would rather bake one
# application into the environment than submit it through the API. A workspace
# that has submitted its own application ignores all three of these.
#
# Prefer the API. It supports a certificate credential, where AuthSec generates
# the key pair and the private half never leaves the secrets store; these
# variables can only carry a client secret, which sits in a file on disk.
#
# Unset, the Azure routes report themselves not configured rather than failing
# mid-redirect.
# AZURE_CLIENT_ID=
#
# The client secret VALUE, not the secret id. Read by the backend only, never
# returned by an API and never written to a log line.
# AZURE_CLIENT_SECRET=
#
# Must match a redirect URI registered on the app registration EXACTLY, scheme
# and trailing slash included. Microsoft refuses to redirect anywhere else, so
# this value is what pins the callback route's path.
# AZURE_REDIRECT_URI=http://localhost:8080/api/azure/callback

# Optional. Pin the delegated sign-in to one tenant. The default is "common",
# which accepts a work account from any directory AND an account whose credential
# lives in the consumer system -- an address that signed up for Azure and became
# an EXTERNAL guest in the directory it administers. Setting "organizations"
# narrows it to work accounts only, and turns those guests away.
# AZURE_SIGNIN_TENANT=

# Optional. Sovereign clouds: Azure Government and Azure China run identity,
# Resource Manager AND Microsoft Graph on different hostnames. All three default
# to the public cloud, and all three must be set together -- setting two leaves
# Graph pointed at the public cloud, where the sovereign tenant does not exist.
# AZURE_AUTHORITY_HOST=https://login.microsoftonline.com
# AZURE_ARM_ENDPOINT=https://management.azure.com
# AZURE_GRAPH_ENDPOINT=https://graph.microsoft.com

# Optional, OFF by default, and it grants real privilege -- read before setting.
#
# A tenant-wide Reader grant targets the tenant's ROOT management group, which
# an operator can only write to while holding root User Access Administrator.
# With this set, AuthSec raises the signed-in operator to that role, makes the
# assignment, and removes the raise in the same run, reporting whether the
# removal succeeded. Root User Access Administrator does NOT expire on its own.
#
# It ships off because that path has not yet been exercised against a real
# tenant: every verified run so far had an operator who already held the
# privilege, so the raise never executed. Leave it unset and an operator without
# the privilege gets manual instructions instead of a silent elevation.
# AZURE_ALLOW_ROOT_ELEVATION=true
